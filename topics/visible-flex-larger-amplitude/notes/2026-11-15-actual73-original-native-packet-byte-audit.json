          "line": 162,
          "text": "   if(!accepted)throw new Error(\"multiple-shooting line search failed at \"+ev.norm);"
        },
        {
          "line": 206,
          "text": " return {tail,cutJets,audit,tangentGraphAtCut,heightJetJacobian,solve(height,opts={}){const r=profile(1).r,target=Float64Array.from(height,v=>v/r**4),sol=tail.solve(target,opts),result={...sol,jets:cutJets(sol.states[0]),audit:opts.audit?audit(sol,opts.auditSteps??tail.parameters.steps):null};if(opts.jacobian){const j=heightJetJacobian(result);result.graphJacobian=j.graph;result.heightJetJacobian=j.matrix;result.heightJetJacobianRows=j.rows;}return result;}};"
        }
      ]
    },
    "topics/visible-flexible-closed-surface/scripts/78718-prefix-tail-tangent-fourier-worker.mjs": {
      "bytes": 12294,
      "sha256": "36cf8235d42dfdb2477e6e709dfb721633ac39259b45aeadff2e13491e64864a",
      "exact_lines": [
        {
          "line": 144,
          "text": "  const sol=dn.solve(req.height,{maxIterations:cfg.maxIterations??24,tolerance:cfg.solveTolerance??2e-10,initial,jacobian:!!req.jacobian,audit:!!req.audit,auditSteps:cfg.auditSteps??cfg.steps,trialDiagnostic:retainTrial,progress:(row,states)=>{if(states){progressStates=states;progressRow=row;retainIteration(row,states);}trace({event:'iteration',call,elapsed_ms:Date.now()-start,...row});}});"
        },
        {
          "line": 157,
          "text": " }catch(e){trace({event:'failure',call,error:String(e)});console.log(JSON.stringify({failed:String(e),lastIteration:progressRow,checkpoint:progressStates?{parameters:dn.tail.parameters,states:progressStates,rawNode:dn.tail.rawNode,rawStates:dn.tail.rawNode.map(n=>progressStates[n]),cutHeight:currentHeight,scope:'FAILED Newton state; retained only for diagnosis and possible initial guesses.'}:null}));}"
        }
      ]
    }
