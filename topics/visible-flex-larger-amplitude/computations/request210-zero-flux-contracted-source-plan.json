bservation\")\n        if observation is not None:\n            last.append(dict(engine_index=row.get(\"engine_index\"),first_stage=row.get(\"first_stage\"),\n                stage_count=row.get(\"stage_count\"),last_observation=small_original(observation),\n                calls_started=c.get(\"calls_started\"),calls_completed=c.get(\"calls_completed\")))\n    return dict(actual_integer_counter_totals=totals,actual_fallback_reason_counts=reasons,\n        missing_counter_scopes=missing,\n        declared_eligibility_groups=[dict(scope=json.loads(k),actual_engine_indices=v)\n                                    for k,v in scopes.items()],\n        last_actual_observation_per_recorded_engine=last,\n        full_per_call_eligibility_history_not_recorded=True,\n        eligibility_failure_is_original_full_angular_fallback_not_scientific_rejection=True,\n        original_root_primal_values_or_speedup_not_reconstructed=True,\n        counters_do_not_prove_complete_current_J_or_native_acceptance=True)\n\n\ndef trace_stats(value):"
