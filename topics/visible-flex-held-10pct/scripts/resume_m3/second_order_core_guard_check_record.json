    "unchanged_grid_ceiling": 32768,
    "second_derivative_scope": "Whole-domain analytic primary and full-control bounds; the unchanged numerical coefficient/evaluation allowance is retained.",
    "additions": [
      [
        "rb=db=np.zeros(0);control_error=0.",
        "rb=db=ddb=np.zeros(0);control_error=0."
      ],
      [
        "rb,db,_=self.basis.homotopy_rho_bounds(self.lam)",
        "rb,db,ddb=self.basis.homotopy_rho_bounds(self.lam)"
      ],
      [
        "            # Coefficient uncertainty is certified by rational moment intervals.",
        "            # The C4 cutoff obeys |chi'|<=630/(256*eps) and\n            # |chi''|<=2520/(64*eps**2) on its whole transition.\n            # rho''=q*((1-lambda*chi)*s''-2*lambda*chi'*s'\n            #           -lambda*chi''*(s+beta-C)) + full control rho''.\n            # Here 0<=lambda*chi<=1, and every control bound comes from\n            # the original exact-coefficient/analytic cutoff budgets.\n            n=self.base_mode;eta=self.bimodal_eta;factor=self.factor\n            smooth_first=factor*n*(1+3*eta)\n            smooth_second=factor*n*n*(1+5*eta)\n            delta_upper=factor*(1+2*eta)+abs(self.local_flatten_beta)+abs(self._circle_constant)\n            base_second=self.q*(smooth_second+self.lam*(2*(630/256)/self.transition*smooth_first+(2520/64)/self.transition**2*delta_upper))\n            self.rho_second_derivative_bound=math.nextafter((base_second+float(np.sum(abs(self.c)*ddb)))*(1+128*np.finfo(float).eps),math.inf)\n            # Coefficient uncertainty is certified by rational moment intervals."
      ],
      [
        "                self.rho_lower=max(self.rho_triangle_lower,float(rr.min()-slack))\n                self.rho_upper=min(self.rho_triangle_upper,float(rr.max()+slack))",
        "                second_slack=math.nextafter((self.T/count)**2*self.rho_second_derivative_bound/8*(1+128*np.finfo(float).eps)+self.rho_value_roundoff_allowance,math.inf)\n                self.rho_lower=max(self.rho_triangle_lower,float(rr.min()-slack),float(rr.min()-second_slack))\n                self.rho_upper=min(self.rho_triangle_upper,float(rr.max()+slack),float(rr.max()+second_slack))"
      ],
      [
        "                       rho_value_roundoff_allowance=self.rho_value_roundoff_allowance,",
        "                       rho_value_roundoff_allowance=self.rho_value_roundoff_allowance,\n                       rho_second_derivative_bound=self.rho_second_derivative_bound,\n                       numerical_positivity_guard='Maximum of original triangle, original first derivative grid, and C2 interpolation lower bounds',"
      ]
    ]
  },
