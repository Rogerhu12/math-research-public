poly residual=h;poly gg=gcd(residual,known);while(deg(gg)>0){residual=residual/gg;gg=gcd(residual,known);}
write("/home/runner/work/_temp/isp-r150-module-31/denominator.sing","poly unresolvedDenominator="+string(residual)+";");
write("/home/runner/work/_temp/isp-r150-module-31/denominator.sing",string(factorize(residual)));
